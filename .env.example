# PostgreSQL container
POSTGRES_DB=ems_thermal_lstm
POSTGRES_USER=ems_user
POSTGRES_PASSWORD=change-postgres-password
POSTGRES_PORT=5432

# Shared application connection string
DATABASE_URL=postgres://ems_user:change-postgres-password@localhost:5432/ems_thermal_lstm?sslmode=disable

# Backend bootstrap and internal tokens
GATEWAY_TOKEN=change-gateway-token
ADMIN_TOKEN=change-admin-token
INTERNAL_ML_TOKEN=change-internal-ml-token

# Telegram is disabled until explicitly configured
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
