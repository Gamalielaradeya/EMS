# Raspberry Pi Gateway — VPS Runtime Environment
# Copy file ini ke: gateway-rpi/.env di Raspberry Pi
# Isi BACKEND_TOKEN dengan nilai GATEWAY_TOKEN dari backend VPS .env

# Backend VPS endpoint via ZeroTier
BACKEND_BASE_URL=http://10.147.17.227:8081/api/v1

# Token untuk autentikasi gateway ke backend
# Gunakan nilai yang sama dengan GATEWAY_TOKEN di backend-go/.env VPS
BACKEND_TOKEN=<SAME_AS_BACKEND_GATEWAY_TOKEN>
